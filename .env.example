# Environment Variables for Merlin Carwash Website
# Copy this file to .env and update with your actual values

# Flask Secret Key - REQUIRED for production
# Generate a secure key using: python -c "import secrets; print(secrets.token_hex(32))"
# IMPORTANT: This is a placeholder only. DO NOT use this value in production.
# You MUST replace this with your own generated secret key.
FLASK_SECRET_KEY=placeholder-secret-key-do-not-use-in-production

# Flask Debug Mode - Set to 'False' for production
FLASK_DEBUG=False